// SPDX-License-Identifier: GPL-2.0-only
// Definitions for HiFiBerry DAC 8x ADC Pro
/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2835";

	fragment@0 {
		target = <&gpio>;
		__overlay__ {
			rp1_i2s1_dac8xadc: rp1_i2s1_dac8xadc {
				function = "i2s1";
				pins = "gpio18", "gpio19", "gpio20", "gpio21",
				       "gpio22", "gpio23", "gpio24", "gpio25",
				       "gpio26", "gpio27";
				bias-disable;
				status = "okay";
			};
		};
	};

	frag1: fragment@1 {
		target = <&i2s_clk_consumer>;
		__overlay__ {
			pinctrl-names="default";
			pinctrl-0=<&rp1_i2s1_dac8xadc>;
			status = "okay";
		};
	};

	fragment@2 {
		target-path = "/";
		__overlay__ {
			dacpro_osc: dacpro_osc {
				compatible = "hifiberry,dacpro-clk";
				#clock-cells = <0>;
				clock-output-names = "dacpro_clk";
			};
		};
	};

	fragment@3 {
		target = <&i2c1>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			hb_dac_1: pcm5122@4c {
				#sound-dai-cells = <0>;
				compatible = "ti,pcm5122";
				reg = <0x4c>;
				clocks = <&dacpro_osc>;
				sound-name-prefix = "DAC1";
				status = "okay";
				AVDD-supply = <&vdd_3v3_reg>;
				DVDD-supply = <&vdd_3v3_reg>;
				CPVDD-supply = <&vdd_3v3_reg>;
			};
			hb_dac_2: pcm5122@4d {
				#sound-dai-cells = <0>;
				compatible = "ti,pcm5122";
				reg = <0x4d>;
				clocks = <&dacpro_osc>;
				sound-name-prefix = "DAC2";
				status = "okay";
				AVDD-supply = <&vdd_3v3_reg>;
				DVDD-supply = <&vdd_3v3_reg>;
				CPVDD-supply = <&vdd_3v3_reg>;
			};
			hb_dac_3: pcm5122@4e {
				#sound-dai-cells = <0>;
				compatible = "ti,pcm5122";
				reg = <0x4e>;
				clocks = <&dacpro_osc>;
				sound-name-prefix = "DAC3";
				status = "okay";
				AVDD-supply = <&vdd_3v3_reg>;
				DVDD-supply = <&vdd_3v3_reg>;
				CPVDD-supply = <&vdd_3v3_reg>;
			};
			hb_dac_4: pcm5122@4f {
				#sound-dai-cells = <0>;
				compatible = "ti,pcm5122";
				reg = <0x4f>;
				clocks = <&dacpro_osc>;
				sound-name-prefix = "DAC4";
				status = "okay";
				AVDD-supply = <&vdd_3v3_reg>;
				DVDD-supply = <&vdd_3v3_reg>;
				CPVDD-supply = <&vdd_3v3_reg>;
			};
			hb_adc_1: pcm186x@4a {
				#sound-dai-cells = <0>;
				compatible = "ti,pcm1863";
				reg = <0x4a>;
				clocks = <&dacpro_osc>;
				sound-name-prefix = "ADC";
				status = "okay";
				AVDD-supply = <&vdd_3v3_reg>;
				DVDD-supply = <&vdd_3v3_reg>;
				CPVDD-supply = <&vdd_3v3_reg>;
			};
		};
	};

	fragment@4 {
		target = <&sound>;
		hifiberry_dac8xadcpro: __overlay__ {
			compatible = "hifiberry,hifiberry-dac8xadcpro";
			audio-codec = <&hb_dac_1 &hb_dac_2 &hb_dac_3 &hb_dac_4 &hb_adc_1>;
			i2s-controller = <&i2s_clk_consumer>;
			status = "okay";
		};
	};

	fragment@5 {
		target = <&i2s_clk_consumer>;
		__overlay__ {
		compatible = "snps,designware-i2s";
				clocks = <&dacpro_osc>;
				clock-names = "dacpro_clk";
				status = "okay";
		};
	};

	__overrides__ {
		24db_digital_gain =
			<&hifiberry_dac8xadcpro>,"hifiberry-dac8xadcpro,24db_digital_gain?";
		leds_off = <&hifiberry_dac8xadcpro>,"hifiberry-dac8xadcpro,leds_off?";
	};
};
